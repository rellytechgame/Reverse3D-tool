        ],
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "reverse3d_clean_mesh",
      "description": "Repair a mesh: remove degenerate faces and debris, fix normals, fill holes, smooth, decimate, align (OBB/PCA), place on ground and rescale. Returns before/after stats.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "input_path": {
            "description": "Input mesh.",
            "type": "string"
          },
          "output_path": {
            "description": "Output mesh (.stl/.obj/.ply/.glb/.gltf/.off).",
            "type": "string"
          },
          "keep_largest_only": {
            "default": false,
            "type": "boolean"
          },
          "min_component_ratio": {
            "default": 0.01,
            "exclusiveMaximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "fill_holes": {
            "default": true,
            "type": "boolean"
          },
          "max_hole_edges": {
            "default": 200,
            "maximum": 100000,
            "minimum": 3,
            "type": "integer"
          },
          "fix_normals": {
            "default": true,
            "type": "boolean"
          },
          "smooth_iterations": {
            "default": 0,
            "maximum": 200,
            "minimum": 0,
            "type": "integer"
          },
          "target_faces": {
            "anyOf": [
              {
                "minimum": 4,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Decimate to this many faces."
          },
          "align": {
            "default": "none",
            "enum": [
              "none",
              "center",
              "obb",
              "pca"
            ],
            "type": "string"
          },
          "ground": {
            "default": false,
            "description": "Translate so min Z = 0.",
            "type": "boolean"
          },
          "scale": {
            "default": 1.0,
            "description": "Uniform scale (e.g. 1000 for m→mm).",
            "exclusiveMaximum": 1000000000.0,
            "exclusiveMinimum": 1e-09,
            "type": "number"
          },
          "overwrite": {
            "default": false,
            "description": "Replace existing output files. Default false.",
            "type": "boolean"
          }
        },
        "required": [
          "input_path",
          "output_path"
        ],
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "reverse3d_measure_mesh",
      "description": "Measure a mesh: bounding boxes (axis-aligned and minimum oriented), surface area, volume, watertightness, components and open boundary edges.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "input_path": {
            "description": "Mesh to measure.",
            "type": "string"
          }
        },
        "required": [
          "input_path"
        ],
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "reverse3d_fit_primitives",
      "description": "Detect planes, cylinders and spheres (RANSAC) on a mesh or point cloud and report their parameters (radii, axes, normals). Optionally writes OpenSCAD/CadQuery code.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "input_path": {
            "description": "Mesh or point cloud.",
            "type": "string"
          },
          "kinds": {
            "items": {
              "enum": [
                "plane",
                "cylinder",
                "sphere"
              ],
              "type": "string"
            },
            "maxItems": 3,
            "minItems": 1,
            "type": "array"
          },
          "sample_count": {
            "anyOf": [
              {
                "maximum": 500000,
                "minimum": 100,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "null = profile."
          },
          "threshold": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Inlier distance; null = 1% of bbox diagonal."
          },
          "max_primitives": {
            "default": 8,
            "maximum": 50,
            "minimum": 1,
            "type": "integer"
          },
          "min_inlier_ratio": {
            "default": 0.05,
            "exclusiveMaximum": 1,
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "parametric_output": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Optional .scad (OpenSCAD) or .py (CadQuery) file to generate."
          },
          "overwrite": {
            "default": false,
            "description": "Replace existing output files. Default false.",
            "type": "boolean"
          }
        },
        "required": [
          "input_path"
        ],
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "reverse3d_render",
      "description": "Render a mesh to PNG headlessly with Blender (Cycles/Eevee/Workbench) or PyVista, with studio lighting, material color and optional turntable frames.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "mesh_path": {
            "description": "Mesh to render.",
            "type": "string"
          },
          "output_path": {
            "description": "Output .png (turntables add _0000 suffixes).",
            "type": "string"
          },
          "backend": {
            "default": "auto",
            "enum": [
              "auto",
              "blender",
              "pyvista"
            ],
            "type": "string"
          },
          "width": {
            "anyOf": [
              {
                "maximum": 8192,
                "minimum": 64,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "null = profile."
          },
          "height": {
            "anyOf": [
              {
                "maximum": 8192,
                "minimum": 64,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "null = profile."
          },
          "engine": {
            "default": "cycles",
            "enum": [
              "cycles",
              "eevee",
              "workbench"
            ],
            "type": "string"
          },
          "device": {
            "default": "auto",
            "description": "auto = device setting.",
            "enum": [
              "auto",
              "cpu",
              "gpu"
            ],
            "type": "string"
          },
          "samples": {
            "anyOf": [
              {
                "maximum": 4096,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "null = profile."
          },
          "color": {
            "default": "#9aa4b2",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "metallic": {
            "default": 0.0,
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "roughness": {
            "default": 0.45,
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "background": {
            "default": "#f4f5f7",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "transparent": {
            "default": false,
            "type": "boolean"
          },
          "elevation_deg": {
            "default": 25.0,
            "maximum": 89,
            "minimum": -89,
            "type": "number"
          },
