          },
          "thickness": {
            "default": 10.0,
            "description": "Extrusion height in output units.",
            "exclusiveMinimum": 0,
            "maximum": 1000000.0,
            "type": "number"
          },
          "units_per_pixel": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Overrides the scale stored in the JSON."
          },
          "overwrite": {
            "default": false,
            "description": "Replace existing output files. Default false.",
            "type": "boolean"
          }
        },
        "required": [
          "contours_path",
          "output_path"
        ],
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "reverse3d_photogrammetry",
      "description": "Reconstruct a 3D point cloud (and optionally a mesh) from overlapping photos using COLMAP. Long-running (minutes to hours). Run reverse3d_analyze_images first.",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "image_dir": {
            "description": "Folder with >=3 overlapping photos of the object.",
            "type": "string"
          },
          "output_dir": {
            "description": "Folder for the COLMAP workspace and outputs.",
            "type": "string"
          },
          "quality": {
            "anyOf": [
              {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "null = from the performance profile."
          },
          "matcher": {
            "default": "auto",
            "enum": [
              "auto",
              "exhaustive",
              "sequential"
            ],
            "type": "string"
          },
          "dense": {
            "default": "auto",
            "description": "Dense MVS needs a CUDA build of COLMAP. auto = only if GPU.",
            "enum": [
              "auto",
              "on",
              "off"
            ],
            "type": "string"
          },
          "use_gpu": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "null = from the device setting."
          },
          "camera_model": {
            "default": "SIMPLE_RADIAL",
            "enum": [
              "SIMPLE_PINHOLE",
              "PINHOLE",
              "SIMPLE_RADIAL",
              "RADIAL",
              "OPENCV",
              "FULL_OPENCV"
            ],
            "type": "string"
          },
          "build_mesh": {
            "default": true,
            "description": "Poisson-mesh the cloud (needs the [recon] extra).",
            "type": "boolean"
          },
          "overwrite": {
            "default": false,
            "description": "Replace existing output files. Default false.",
            "type": "boolean"
          }
        },
        "required": [
          "image_dir",
          "output_dir"
        ],
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
