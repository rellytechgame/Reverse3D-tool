# reverse3d configuration — copy to .env (never commit .env).
# reverse3d reads *process environment variables*; load this file with your
# shell, direnv, or the "env" block of your MCP client configuration.
# All variables are optional. Values below are the defaults or examples.
# reverse3d itself needs NO credentials.

# Prefer persistent settings: `reverse3d config set <key> <value>` writes
# ~/.reverse3d/config.json. Environment variables override that file.

# Sandbox root for agent tool calls (MCP / `reverse3d agent call`).
REVERSE3D_WORKSPACE=./workspace

# Compute device: auto | cpu | gpu
REVERSE3D_DEVICE=auto
# Performance profile: fast | balanced | quality
REVERSE3D_PROFILE=balanced
# CPU threads, 0 = automatic
REVERSE3D_THREADS=0

# Token economy for AI agents: compact | full
REVERSE3D_VERBOSITY=compact
# Tools exposed to agents: full (14 tools) | lean (5 tools)
REVERSE3D_TOOLSET=full

# Resource limits (protect against oversized inputs and runaway agents).
REVERSE3D_MAX_INPUT_MB=512
REVERSE3D_MAX_IMAGE_PIXELS=100000000
REVERSE3D_MAX_IMAGES=500
REVERSE3D_MAX_MESH_FACES=5000000
REVERSE3D_TIMEOUT_S=3600

# Explicit binaries (otherwise searched on PATH).
# REVERSE3D_BLENDER=/opt/blender/blender
# REVERSE3D_COLMAP=/usr/local/bin/colmap

# Logging (always on stderr).
REVERSE3D_LOG_LEVEL=INFO
REVERSE3D_LOG_JSON=0

# Only for examples/claude_agent.py — prefer `ant auth login` over a static key.
# ANTHROPIC_API_KEY=replace-with-your-key-from-the-console
